{
  "name": "@shanu/storybook",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Storybook docs and visual playground for the design system",
  "scripts": {
    "dev": "storybook dev -p 6006",
    "build": "storybook build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"import('node:fs').then(fs => fs.promises.rm('storybook-static', { recursive: true, force: true }))\""
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^9.4.0",
    "@shanu/components": "workspace:*",
    "@shanu/hooks": "workspace:*",
    "@shanu/theme": "workspace:*",
    "@shanu/tokens": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.3.6",
    "@storybook/addon-docs": "10.3.6",
    "@storybook/react-vite": "10.3.6",
    "@types/node": "^26.6.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^5.1.0",
    "storybook": "10.3.6",
    "typescript": "^5.8.2",
    "vite": "^8.3.3"
  }
}
