{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@storybook/react-vite": [
        "./node_modules/@storybook/react-vite/dist/index.d.ts"
      ],
      "storybook/test": ["./node_modules/storybook/dist/test/index.d.ts"]
    }
  },
  "include": [
    ".storybook/**/*",
    "../../packages/components/src/**/*.stories.tsx"
  ]
}
