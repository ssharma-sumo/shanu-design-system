{
  "name": "@shanu/tokens",
  "version": "0.0.0",
  "private": true,
  "description": "Design tokens — JS/TS, SCSS, and CSS outputs",
  "type": "module",
  "main": "./build/light/tokens.ts",
  "types": "./build/light/tokens.d.ts",
  "exports": {
    ".": {
      "types": "./build/light/tokens.d.ts",
      "default": "./build/light/tokens.ts"
    },
    "./light": {
      "types": "./build/light/tokens.d.ts",
      "default": "./build/light/tokens.ts"
    },
    "./dark": {
      "types": "./build/dark/tokens.d.ts",
      "default": "./build/dark/tokens.ts"
    },
    "./css/light": "./build/light/variables.css",
    "./css/dark": "./build/dark/variables.css",
    "./scss/light": "./build/light/_variables.scss",
    "./scss/dark": "./build/dark/_variables.scss"
  },
  "files": [
    "build",
    "tokens",
    "src"
  ],
  "scripts": {
    "build": "node style-dictionary.config.mjs",
    "dev": "node style-dictionary.config.mjs",
    "lint": "echo \"@shanu/tokens: lint not configured yet\"",
    "typecheck": "pnpm build && tsc --noEmit",
    "clean": "node -e \"import('node:fs').then(fs => fs.promises.rm('build', { recursive: true, force: true }))\""
  },
  "devDependencies": {
    "style-dictionary": "^4.4.0",
    "typescript": "^5.8.2"
  }
}
