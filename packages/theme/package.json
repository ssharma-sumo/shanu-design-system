{
  "name": "@shanu/theme",
  "version": "0.0.0",
  "private": true,
  "description": "MUI theme built from @shanu/tokens",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "prebuild": "pnpm --filter @shanu/tokens build",
    "build": "tsc --noEmit",
    "dev": "pnpm run build",
    "lint": "echo \"@shanu/theme: lint not configured yet\"",
    "typecheck": "pnpm run prebuild && tsc --noEmit",
    "clean": "echo \"@shanu/theme: nothing to clean yet\""
  },
  "dependencies": {
    "@shanu/tokens": "workspace:*"
  },
  "peerDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^6.0.0 || ^7.0.0 || ^9.0.0",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^9.4.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.8.2"
  }
}
