{
  "name": "@shanu/hooks",
  "version": "0.0.0",
  "private": true,
  "description": "Reusable React hooks for the design system",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "lint": "echo \"@shanu/hooks: lint not configured yet\"",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"import('node:fs').then(fs => fs.promises.rm('dist', { recursive: true, force: true }))\""
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.0.10",
    "react": "^19.0.0",
    "typescript": "^5.8.2",
    "vite": "^8.3.3",
    "vite-plugin-dts": "^5.1.2"
  }
}
